# Copy to `.env.local` and fill in. Nothing here is required for the current
# Phase 0 / Phase 1 skeleton — the app runs without any of these.

# Supabase. Optional — without these the app stays on placeholder data.
# Requires anonymous sign-ins to be enabled; see supabase/README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Voice + review generation (Phase 4 / Phase 5). Server-side only — this key
# must never be exposed to the browser.
OPENAI_API_KEY=

# Server-side only. Written by the voice API route to record usage, which users
# must not be able to write themselves — they could delete their own rows and
# reset their own quota.
SUPABASE_SERVICE_ROLE_KEY=
