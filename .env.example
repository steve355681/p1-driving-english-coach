# Copy to `.env.local` and fill in what you need.
#
# None of these are required to run the app. Without Supabase it falls back to
# `lib/placeholder-data.ts` and every affected screen shows a 示範資料 badge.
# See the table in README.md for what each one turns on.

# Supabase. Both or neither — one alone does nothing.
# Requires anonymous sign-ins to be enabled; see supabase/README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Voice, review generation and note condensing.
#
# Server-side only. Never prefix this NEXT_PUBLIC_ — that ships the key to the
# browser, where anyone can read it out of the bundle and spend it.
OPENAI_API_KEY=

# Server-side only, for the /api routes.
#
# Bypasses row level security entirely. It exists so the API routes can write
# rows users must not write themselves: usage records, which they could
# otherwise delete to reset their own daily quota.
SUPABASE_SERVICE_ROLE_KEY=

# Who may spend metered voice on this deployment.
#
#   trial      (default) any signed-in visitor gets one 3-minute session a day
#   allowlist  only users with a voice_entitlements row; everything else works
#
# `trial` is what makes a public URL demoable, and is also a standing offer to
# spend money on strangers. Switch to `allowlist` if that stops being a trade
# you want to make.
VOICE_ACCESS=

# Set to 1 only once the sign-in emails actually contain a code.
#
# Editing Supabase's email templates needs custom SMTP or a paid plan, so on a
# default free project the code never arrives. With this off the email path uses
# the link instead, which always works — a code field the email cannot fill
# reads as a broken product rather than a missing prerequisite.
#
# See supabase/README.md for the two templates that need {{ .Token }}.
NEXT_PUBLIC_EMAIL_CODE=
